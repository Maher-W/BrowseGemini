{
  "manifest_version": 3,
  "name": "BrowseGemini - Live Browser Controller",
  "version": "1.0.0",
  "description": "Ultra-lightweight bridge connecting Google Gemini (via MCP) to live Google Chrome tabs via CDP and extension APIs.",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms",
    "sessions"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BrowseGemini",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
