# ==============================================================================
# Gemini Browser Bridge - Environment Configuration
# ==============================================================================

# Server network binding
PORT=8080
HOST=0.0.0.0

# Persistent directory for OAuth client registrations and Gemini access tokens.
# Mount this to a persistent Docker volume in Coolify so restarts/redeployments
# do not disconnect Gemini.
DATA_DIR=/data

# Public HTTPS URL configured in Coolify (e.g. https://mcp.yourdomain.com).
# This is used to advertise OAuth 2.0 endpoints to Google Gemini.
BASE_URL=https://mcp.yourdomain.com

# Password required on the web authorization screen when connecting Gemini.
# Choose a strong password.
ADMIN_PASSWORD=change-this-to-a-strong-admin-password

# Secret token shared between this remote server and the Chrome Extension.
# Enter this exact token in the Chrome Extension popup UI.
EXTENSION_SECRET_TOKEN=generate-a-strong-random-token-here
