# ==============================================================================
# BrowseGemini - Environment Configuration
# ==============================================================================

# Server network binding
PORT=8080
HOST=0.0.0.0

# Persistent directory for OAuth client registrations and Gemini access tokens.
# Mount this to a persistent volume or local directory so restarts do not disconnect Gemini.
DATA_DIR=/data

# Public HTTPS URL configured on your server/domain (e.g. https://browse.gemini.code.ebda3is.com).
# For local testing, you can use http://localhost:8080
BASE_URL=https://mcp.yourdomain.com

# Single password used for BOTH Gemini OAuth login AND Chrome Extension WebSocket authentication.
# Set a strong password here.
ADMIN_PASSWORD=change-this-to-a-secure-password
